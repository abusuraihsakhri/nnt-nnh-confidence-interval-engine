{
  "openapi": "3.1.0",
  "info": {
    "title": "NNT / NNH Confidence Interval Engine API",
    "version": "1.0.0",
    "description": "Independent binomial events; legacy audit routes are demonstration only."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Client-side calculator",
        "responses": {
          "200": {
            "description": "HTML page"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health and audit-key configuration",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON demonstration audit counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/nnt": {
      "post": {
        "summary": "Compute effect sizes and Newcombe–Wilson score confidence intervals",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "control_events": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "control events"
                  },
                  "control_total": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "control total"
                  },
                  "treatment_events": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "treatment events"
                  },
                  "treatment_total": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "treatment total"
                  },
                  "confidence_level": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1,
                    "default": 0.95
                  }
                },
                "required": [
                  "control_events",
                  "control_total",
                  "treatment_events",
                  "treatment_total"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "NNT/NNH, ARR, RR and risk-difference CI; nullable reciprocal CI"
          },
          "422": {
            "description": "Invalid counts or confidence level"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy demonstration audit (not clinically validated)",
        "responses": {
          "200": {
            "description": "Demonstration dossier"
          },
          "422": {
            "description": "Rejected input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock response only, no model calls",
        "responses": {
          "200": {
            "description": "Demonstration response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory HMAC audit ledger; not authenticated multi-user storage",
        "responses": {
          "200": {
            "description": "Ledger snapshot"
          },
          "503": {
            "description": "Audit key not configured"
          }
        }
      }
    }
  }
}
